# clangd is the only C++ language server. It uses the clang frontend, while
# this folder is compiled with g++. Loose .cpp files have no build system, so
# clangd has no flags for them and would default to an older standard and
# report dbg() as dead code.
#
# This file supplies those flags. A real CMake project is unaffected:
# compile_commands.json always wins over this file.
#
# No -I lines are needed. Checked 2026-11-11 with:
#   clang++ -fsyntax-only -std=c++23 -DLOCAL yo.cpp     -> exit 0
# clang 23.1.3 finds GCC 16's libstdc++ on its own, so <bits/stdc++.h>
# resolves without help. Do NOT add -I/usr/lib/gcc/.../16/include: that is
# GCC's own compiler header dir and its stdatomic.h fails under clang with
# "unknown type name '_Bool'".

CompileFlags:
  Add:
    - -std=c++23
    - -DLOCAL
    - -Wall

Diagnostics:
  UnusedIncludes: None
